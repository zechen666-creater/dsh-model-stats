{
  "name": "dsh-model-stats",
  "displayName": "DSH Model Stats 按模型用量",
  "description": "在对话输入框上方按模型分列显示：输出速率(tok/s)、缓存命中率、总 token。",
  "version": "0.9.0",
  "author": "zechen666-creater",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.2"
  }
}
